// J.G. Walsh & Co. Workspace — Prisma schema
// Postgres on Railway. See README.md for setup, migrations, and seed steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Contact ----------
// First editable module. relatedProperty / relatedProject are kept as plain
// strings for now to avoid premature relations; promote to FKs once the
// Property table is real.

enum ContactCategory {
  CONTRACTORS_TRADES
  LEGAL
  INSURANCE
  MUNICIPAL
  UTILITIES
  FINANCE_ACCOUNTING
  REAL_ESTATE_LEASING
  PROPERTY_MANAGEMENT
  TENANTS_OCCUPANTS
  SUPPLIERS
  INSPECTORS_TESTING
  OTHER
}

enum ContactStatus {
  ACTIVE
  PROSPECT
  PREFERRED
  BACKUP
  NEEDS_FOLLOWUP
  INACTIVE
  DO_NOT_USE
}

enum ComplianceStatus {
  UNKNOWN
  MISSING
  REQUESTED
  CURRENT
  EXPIRED
  NOT_REQUIRED
}

model Contact {
  id              String           @id @default(cuid())
  firstName       String?
  lastName        String?
  displayName     String
  company         String?
  role            String?
  category        ContactCategory
  phone           String?
  email           String?
  website         String?
  address         String?
  notes           String?          @db.Text
  isFavorite      Boolean          @default(false)
  status          ContactStatus    @default(ACTIVE)
  relatedProperty String?
  relatedProject  String?
  insuranceStatus ComplianceStatus @default(UNKNOWN)
  licenseStatus   ComplianceStatus @default(UNKNOWN)
  w9Status        ComplianceStatus @default(UNKNOWN)
  // Lightweight avatar customization. Validated against allowlists in
  // src/lib/contact-format.ts; no arbitrary HTML, no uploads.
  avatarMode      String?          // "INITIALS" | "ICON"
  avatarColor     String?          // a name from the avatar palette
  avatarIcon      String?          // a key from the avatar icon registry
  // Company-wide relationship taxonomy. Designed to apply across other
  // modules later (Bids, Documents, Tasks, etc.) — not Contacts-only.
  // Validated against allowlists in src/lib/contact-taxonomy.ts.
  entityType        String?
  relationshipType  String?
  functionalDomain  String?
  specialty         String?
  contextRole       String?
  lastContactedAt DateTime?
  followUpAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category])
  @@index([status])
  @@index([displayName])
  @@index([archivedAt])
}

// ----------------------------------------------------------------------
// MarketManualEntry — manually-captured market values used by /market
// before live integrations (RentCast, ATTOM, etc.) are wired in.
//
// Source attribution defaults to "Manual Internal" — matches the entry
// in the Market Source Registry (src/lib/market-sources.ts). Decimal is
// used for money so currency math stays exact across reads/writes.
// ----------------------------------------------------------------------
model MarketManualEntry {
  id                 String    @id @default(cuid())
  propertyId         String    @unique // one current entry per property
  propertyLabel      String

  estimatedValue     Decimal?  @db.Decimal(14, 2)
  estimatedRent      Decimal?  @db.Decimal(10, 2)
  assessedValue      Decimal?  @db.Decimal(14, 2)
  annualTaxes        Decimal?  @db.Decimal(12, 2)
  purchaseBasis      Decimal?  @db.Decimal(14, 2)
  renovationBudget   Decimal?  @db.Decimal(14, 2)
  targetRent         Decimal?  @db.Decimal(10, 2)

  sourceName         String?   @default("Manual Internal")
  sourceNote         String?   @db.Text
  asOfDate           DateTime?
  // "UNKNOWN" | "LOW" | "MEDIUM" | "HIGH" — validated in app code.
  confidence         String?

  // Mirrors TrackedProperty.kind === "private". Used to keep 14 MacAffer
  // Dr out of business KPIs even when manual data exists for it.
  isPrivateReference Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([propertyId])
}

// ----------------------------------------------------------------------
// MarketSourceSnapshot — one row per external-provider fetch attempt.
// First consumer is RentCast (provider = "RentCast"). Each refresh
// inserts a new row so we keep history; "latest snapshot" is computed
// per property via fetchedAt desc.
//
// status:
//   "SUCCESS" — provider returned data we could parse
//   "NO_DATA" — provider returned 200 with no value/rent populated
//   "ERROR"   — non-200, network failure, or parse error (errorMessage set)
// sourceType:
//   "SNAPSHOT" — combined value + rent fetched in one refresh
//   "VALUE_ESTIMATE" — value only (reserved for future granular fetches)
//   "RENT_ESTIMATE"  — rent only  (reserved for future granular fetches)
// ----------------------------------------------------------------------
// ----------------------------------------------------------------------
// WorkspaceSetting — minimal key/value store for workspace-wide
// configuration that needs to outlive the per-browser session cookie.
//
// First consumer is Google Drive folder bookkeeping (see
// src/lib/google-drive.ts), which needs to remember which Drive folder
// IDs the workspace has created so re-running the setup action does
// not duplicate the folder tree on a second browser.
//
// The value is stored as JSONB so future settings (key-value preferences,
// other singleton state) can reuse the same row shape without another
// migration. Schemas for each `key` are validated in app code.
// ----------------------------------------------------------------------
model WorkspaceSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// DriveDocument — metadata for a file that has been uploaded to the
// workspace's Google Drive folder structure.
//
// Drive file ids and web URLs come back from Google's `files.create`
// response. We persist them here so the Documents workspace can list
// uploaded files across browser sessions and devices without hitting
// Drive on every page load.
//
// `category` and `extractionStatus` are stored as strings rather than
// Postgres enums so adding/renaming a category does not require a
// schema migration. Validation lives in app code (see
// `src/lib/document-categories.ts`-style allowlists).
//
// Adobe extraction is intentionally NOT run on upload. `extractionStatus`
// defaults to "not_started" and is only flipped after an explicit user
// action (future task — not part of this pass).
// ----------------------------------------------------------------------
model DriveDocument {
  id                  String   @id @default(cuid())
  name                String
  /// User-selected document category. Validated against an app-level
  /// allowlist (see DocumentCategory in src/lib/mock-data.ts).
  category            String
  /// Optional slug of a tracked property the file is linked to.
  linkedPropertySlug  String?
  driveFileId         String   @unique
  driveWebUrl         String
  mimeType            String
  sizeBytes           Int
  /// "not_started" | "extracting" | "draft_ready" | "failed" — drives
  /// the per-row extraction action UI. Older callers also recognize
  /// "reviewed" once a user has signed off on the draft.
  extractionStatus    String   @default("not_started")
  uploadedAt          DateTime @default(now())

  /// Adobe PDF Extract result. Stored as JSONB so we keep the full
  /// `structuredData.json` Adobe returns; the UI reads only fields it
  /// understands. Optional — only set once an extraction completes.
  extractedJson       Json?
  /// Plain-text preview assembled from the extracted elements. Used by
  /// the UI when the structured fields are still unstructured.
  extractedText       String?  @db.Text
  /// Timestamp of the most recent successful extraction.
  extractedAt         DateTime?
  /// Sanitized error string from the most recent failed extraction.
  /// Cleared on the next successful run.
  extractionError     String?

  /// "not_reviewed" | "reviewing" | "draft_ready" | "failed" — drives
  /// the per-row AI review button UI. Null means "not_reviewed".
  aiReviewStatus      String?
  /// Structured review object (documentType, summary, parties, dates,
  /// risks, suggestedTasks, …). Shape is validated in app code so we
  /// don't lock the schema to a particular field set.
  aiReviewJson        Json?
  /// Provider used for the most recent successful review.
  /// "openai" | "xai" — string for forward compatibility.
  aiReviewProvider    String?
  /// Timestamp of the most recent successful review.
  aiReviewedAt        DateTime?
  /// Sanitized error string from the most recent failed review.
  aiReviewError       String?

  @@index([linkedPropertySlug])
  @@index([category])
  @@index([uploadedAt])
}

// ----------------------------------------------------------------------
// Task — persisted workspace task. First-pass shape is intentionally
// thin: enough fields to render the same kind of card the legacy
// mock-data `Task` produces (in src/lib/mock-data.ts) plus a source
// reference for tasks drafted from an AI document review.
//
// `status` and `priority` are stored as strings (validated in app code,
// see src/lib/task-proposal.ts allowlists) so adding new values does
// not require another migration. The mock `Task` type is kept for the
// older /renovation reads; this model is the authoritative store going
// forward.
//
// Source linkage:
//   - sourceType = "manual" — created via a manual form (future work).
//   - sourceType = "document_proposal" — created from a suggestion in
//     `DriveDocument.aiReviewJson.suggestedTasks`. `sourceProposalIndex`
//     identifies which entry in that array drove the task so the create
//     action can dedupe idempotently.
// ----------------------------------------------------------------------
model Task {
  id                   String    @id @default(cuid())
  title                String
  description          String?   @db.Text
  /// "draft" | "blocked" | "needs_decision" | "ready" | "in_progress" | "waiting_on_vendor" | "done"
  status               String    @default("draft")
  /// "low" | "medium" | "high" | "urgent"
  priority             String    @default("medium")
  /// Optional slug of a tracked property (src/lib/market-data.ts).
  propertySlug         String?
  /// Optional document category copied from the source document.
  category             String?
  /// "manual" | "document_proposal"
  sourceType           String    @default("manual")
  /// FK-like reference to DriveDocument.id when sourceType = document_proposal.
  /// String + index, not a foreign key, so the column nulls cleanly if a
  /// document is later removed without touching this row.
  sourceDocumentId     String?
  /// Copy of DriveDocument.name at the time the task was drafted, kept so
  /// the source document name renders even if the doc record changes.
  sourceDocumentName   String?
  /// Index into the source document's aiReviewJson.suggestedTasks array.
  /// Used for dedupe on re-click.
  sourceProposalIndex  Int?
  dueDate              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // ---- Team identity (first-pass team foundation) ----
  // All three FKs are nullable + SetNull so a deleted User does not
  // cascade-delete tasks; the row stays with the audit field cleared.
  createdById          String?
  createdBy            User?     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            User?     @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignedToId         String?
  assignedTo           User?     @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([propertySlug])
  @@index([sourceDocumentId])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([createdById])
}

// ----------------------------------------------------------------------
// User — workspace member identity. Populated on first request from the
// Cloudflare Access / Microsoft Entra headers via the upsert in
// `src/lib/current-user.ts`. Records ownership and assignment metadata
// across team-collaborative modules (first consumer: Task).
//
// `role` is a free-form string defaulting to "operator". RBAC is not
// wired in this pass — the field exists so future work can branch on it
// without another migration.
// ----------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  /// "owner" | "operator" — validated in app code. Not enforced by RBAC
  /// in this pass.
  role          String    @default("operator")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime?

  tasksCreated  Task[] @relation("TaskCreatedBy")
  tasksUpdated  Task[] @relation("TaskUpdatedBy")
  tasksAssigned Task[] @relation("TaskAssignedTo")

  @@index([email])
}

model MarketSourceSnapshot {
  id                 String    @id @default(cuid())
  propertyId         String
  propertyLabel      String
  provider           String
  sourceType         String

  estimatedValue     Decimal?  @db.Decimal(14, 2)
  estimatedRent      Decimal?  @db.Decimal(10, 2)
  valueLow           Decimal?  @db.Decimal(14, 2)
  valueHigh          Decimal?  @db.Decimal(14, 2)
  rentLow            Decimal?  @db.Decimal(10, 2)
  rentHigh           Decimal?  @db.Decimal(10, 2)

  /// Number of comparable properties returned in the raw response, if
  /// the provider includes them (RentCast AVM endpoints commonly do).
  compsCount         Int?
  confidence         String?

  /// Untyped raw provider response, kept for traceability + debugging.
  raw                Json?

  status             String
  errorMessage       String?

  fetchedAt          DateTime  @default(now())
  asOfDate           DateTime?

  isPrivateReference Boolean   @default(false)

  createdAt          DateTime  @default(now())

  @@index([propertyId])
  @@index([provider])
  @@index([sourceType])
  @@index([fetchedAt])
}
