// J.G. Walsh & Co. Workspace — Prisma schema
// Postgres on Railway. See README.md for setup, migrations, and seed steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Contact ----------
// First editable module. relatedProperty / relatedProject are kept as plain
// strings for now to avoid premature relations; promote to FKs once the
// Property table is real.

enum ContactCategory {
  CONTRACTORS_TRADES
  LEGAL
  INSURANCE
  MUNICIPAL
  UTILITIES
  FINANCE_ACCOUNTING
  REAL_ESTATE_LEASING
  PROPERTY_MANAGEMENT
  TENANTS_OCCUPANTS
  SUPPLIERS
  INSPECTORS_TESTING
  OTHER
}

enum ContactStatus {
  ACTIVE
  PROSPECT
  PREFERRED
  BACKUP
  NEEDS_FOLLOWUP
  INACTIVE
  DO_NOT_USE
}

enum ComplianceStatus {
  UNKNOWN
  MISSING
  REQUESTED
  CURRENT
  EXPIRED
  NOT_REQUIRED
}

model Contact {
  id              String           @id @default(cuid())
  firstName       String?
  lastName        String?
  displayName     String
  company         String?
  role            String?
  category        ContactCategory
  phone           String?
  email           String?
  website         String?
  address         String?
  notes           String?          @db.Text
  isFavorite      Boolean          @default(false)
  status          ContactStatus    @default(ACTIVE)
  relatedProperty String?
  relatedProject  String?
  insuranceStatus ComplianceStatus @default(UNKNOWN)
  licenseStatus   ComplianceStatus @default(UNKNOWN)
  w9Status        ComplianceStatus @default(UNKNOWN)
  // Lightweight avatar customization. Validated against allowlists in
  // src/lib/contact-format.ts; no arbitrary HTML, no uploads.
  avatarMode      String?          // "INITIALS" | "ICON"
  avatarColor     String?          // a name from the avatar palette
  avatarIcon      String?          // a key from the avatar icon registry
  // Company-wide relationship taxonomy. Designed to apply across other
  // modules later (Bids, Documents, Tasks, etc.) — not Contacts-only.
  // Validated against allowlists in src/lib/contact-taxonomy.ts.
  entityType        String?
  relationshipType  String?
  functionalDomain  String?
  specialty         String?
  contextRole       String?
  lastContactedAt DateTime?
  followUpAt      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([category])
  @@index([status])
  @@index([displayName])
  @@index([archivedAt])
}

// ----------------------------------------------------------------------
// MarketManualEntry — manually-captured market values used by /market
// before live integrations (RentCast, ATTOM, etc.) are wired in.
//
// Source attribution defaults to "Manual Internal" — matches the entry
// in the Market Source Registry (src/lib/market-sources.ts). Decimal is
// used for money so currency math stays exact across reads/writes.
// ----------------------------------------------------------------------
model MarketManualEntry {
  id                 String    @id @default(cuid())
  propertyId         String    @unique // one current entry per property
  propertyLabel      String

  estimatedValue     Decimal?  @db.Decimal(14, 2)
  estimatedRent      Decimal?  @db.Decimal(10, 2)
  assessedValue      Decimal?  @db.Decimal(14, 2)
  annualTaxes        Decimal?  @db.Decimal(12, 2)
  purchaseBasis      Decimal?  @db.Decimal(14, 2)
  renovationBudget   Decimal?  @db.Decimal(14, 2)
  targetRent         Decimal?  @db.Decimal(10, 2)

  sourceName         String?   @default("Manual Internal")
  sourceNote         String?   @db.Text
  asOfDate           DateTime?
  // "UNKNOWN" | "LOW" | "MEDIUM" | "HIGH" — validated in app code.
  confidence         String?

  // Mirrors TrackedProperty.kind === "private". Used to keep 14 MacAffer
  // Dr out of business KPIs even when manual data exists for it.
  isPrivateReference Boolean   @default(false)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([propertyId])
}

// ----------------------------------------------------------------------
// MarketSourceSnapshot — one row per external-provider fetch attempt.
// First consumer is RentCast (provider = "RentCast"). Each refresh
// inserts a new row so we keep history; "latest snapshot" is computed
// per property via fetchedAt desc.
//
// status:
//   "SUCCESS" — provider returned data we could parse
//   "NO_DATA" — provider returned 200 with no value/rent populated
//   "ERROR"   — non-200, network failure, or parse error (errorMessage set)
// sourceType:
//   "SNAPSHOT" — combined value + rent fetched in one refresh
//   "VALUE_ESTIMATE" — value only (reserved for future granular fetches)
//   "RENT_ESTIMATE"  — rent only  (reserved for future granular fetches)
// ----------------------------------------------------------------------
// ----------------------------------------------------------------------
// WorkspaceSetting — minimal key/value store for workspace-wide
// configuration that needs to outlive the per-browser session cookie.
//
// First consumer is Google Drive folder bookkeeping (see
// src/lib/google-drive.ts), which needs to remember which Drive folder
// IDs the workspace has created so re-running the setup action does
// not duplicate the folder tree on a second browser.
//
// The value is stored as JSONB so future settings (key-value preferences,
// other singleton state) can reuse the same row shape without another
// migration. Schemas for each `key` are validated in app code.
// ----------------------------------------------------------------------
model WorkspaceSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------
// DriveDocument — metadata for a file that has been uploaded to the
// workspace's Google Drive folder structure.
//
// Drive file ids and web URLs come back from Google's `files.create`
// response. We persist them here so the Documents workspace can list
// uploaded files across browser sessions and devices without hitting
// Drive on every page load.
//
// `category` and `extractionStatus` are stored as strings rather than
// Postgres enums so adding/renaming a category does not require a
// schema migration. Validation lives in app code (see
// `src/lib/document-categories.ts`-style allowlists).
//
// Adobe extraction is intentionally NOT run on upload. `extractionStatus`
// defaults to "not_started" and is only flipped after an explicit user
// action (future task — not part of this pass).
// ----------------------------------------------------------------------
model DriveDocument {
  id                  String   @id @default(cuid())
  name                String
  /// User-selected document category. Validated against an app-level
  /// allowlist (see DocumentCategory in src/lib/mock-data.ts).
  category            String
  /// Optional slug of a tracked property the file is linked to.
  linkedPropertySlug  String?
  driveFileId         String   @unique
  driveWebUrl         String
  mimeType            String
  sizeBytes           Int
  /// "not_started" | "draft_ready" | "reviewed" — see DocumentExtractionStatus
  /// in src/lib/mock-data.ts.
  extractionStatus    String   @default("not_started")
  uploadedAt          DateTime @default(now())

  @@index([linkedPropertySlug])
  @@index([category])
  @@index([uploadedAt])
}

model MarketSourceSnapshot {
  id                 String    @id @default(cuid())
  propertyId         String
  propertyLabel      String
  provider           String
  sourceType         String

  estimatedValue     Decimal?  @db.Decimal(14, 2)
  estimatedRent      Decimal?  @db.Decimal(10, 2)
  valueLow           Decimal?  @db.Decimal(14, 2)
  valueHigh          Decimal?  @db.Decimal(14, 2)
  rentLow            Decimal?  @db.Decimal(10, 2)
  rentHigh           Decimal?  @db.Decimal(10, 2)

  /// Number of comparable properties returned in the raw response, if
  /// the provider includes them (RentCast AVM endpoints commonly do).
  compsCount         Int?
  confidence         String?

  /// Untyped raw provider response, kept for traceability + debugging.
  raw                Json?

  status             String
  errorMessage       String?

  fetchedAt          DateTime  @default(now())
  asOfDate           DateTime?

  isPrivateReference Boolean   @default(false)

  createdAt          DateTime  @default(now())

  @@index([propertyId])
  @@index([provider])
  @@index([sourceType])
  @@index([fetchedAt])
}
