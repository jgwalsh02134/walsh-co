# Postgres connection string for the J.G. Walsh & Co. workspace database.
# Local development: a Postgres container or a Railway database branch URL.
# Production: provided by the Railway walsh-co service (do not commit real values).
DATABASE_URL=""

# RentCast API key for Market Tracker valuation + rent estimates.
# Server-only; read by src/lib/rentcast.ts. Never commit a real value.
RENTCAST_API_KEY=

# ATTOM Data API key for property records / tax-assessment / sales history.
# Server-only; read by src/lib/attom.ts. Never commit a real value.
ATTOM_API_KEY=

# FRED API key for macro / rate context (mortgage, Treasury, CPI, etc.).
# Server-only; read by src/lib/fred.ts. Never commit a real value.
FRED_API_KEY=

# Zillow Research — ZHVI by ZIP CSV download URL.
# Server-only; read by src/lib/zillow-research.ts. The full file is fetched
# and parsed inside the server action; never embed an API key here. Never
# commit a real value.
ZILLOW_ZHVI_ZIP_CSV_URL=

# OpenAI Responses API key for server-side workspace AI helper.
# Server-only; read by src/lib/openai.ts. Never commit a real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# xAI / Grok — optional second AI provider for the Market Tracker.
# Server-only; read by src/lib/xai.ts. Never commit a real value.
# When XAI_API_KEY is set, the AI panel exposes a Grok provider option.
# XAI_MODEL defaults to grok-4.3. XAI_BASE_URL defaults to https://api.x.ai/v1.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# Microsoft Graph — first-pass workspace integration (Outlook drafts only).
# Server-only; read by src/lib/microsoft-graph.ts. Never commit a real value.
#
# Status: foundation. Cloudflare Access + Microsoft Entra protect the
# production app, but the workspace does not yet have its own MSAL flow
# to acquire a per-user Graph access token. Until that flow is added,
# this env var is the bridge — paste a delegated-permission access token
# here for the user whose mailbox should receive drafts.
#
# Required Microsoft Graph delegated permissions (configure on the Entra
# app registration):
#   - User.Read              (sign-in identity)
#   - Mail.ReadWrite         (REQUIRED for createOutlookDraftEmail)
#   - Calendars.ReadWrite    (future: workspace calendar)
#   - Files.ReadWrite        (future: OneDrive document upload)
#   - offline_access         (refresh tokens)
#
# This first pass uses ONLY Mail.ReadWrite. There is no sendMail call
# anywhere in the codebase — drafts only.
MS_GRAPH_ACCESS_TOKEN=

# Google OAuth + Gmail — first-pass workspace integration (Gmail drafts only).
# Server-only; read by src/lib/google-gmail.ts. Never commit a real value.
#
# OAuth scope (configured on the Google Cloud client):
#   https://www.googleapis.com/auth/gmail.compose
#
# This first pass uses ONLY gmail.compose. There is no `users.messages.send`
# call anywhere in the codebase — drafts only.
#
# Token storage: encrypted httpOnly cookie (AES-256-GCM, key derived from
# GOOGLE_CLIENT_SECRET). No Postgres schema change. Rotating
# GOOGLE_CLIENT_SECRET invalidates all Google sessions, which is the
# desired behaviour after a credential rotation.
#
# OAuth callback path: /api/auth/google/callback
# Add the absolute URL of that path to the OAuth client's "Authorized
# redirect URIs" list in Google Cloud Console.
#
# REDIRECT URI: must be set explicitly on Railway. Inbound traffic
# reaches the container on localhost:<PORT> (typically 8080) even
# though Cloudflare Access proxies the public domain to it, so deriving
# the redirect_uri from `request.origin` produces
# `https://localhost:8080/...` and Google rejects with
# `redirect_uri_mismatch`. Set the public callback URL here:
#   Production: https://app.walshco.ltd/api/auth/google/callback
#   Local dev:  leave unset (defaults to
#               http://localhost:3000/api/auth/google/callback)
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to expose Gmail draft entry points in the UI.
GOOGLE_GMAIL_DRAFTS_ENABLED=true
